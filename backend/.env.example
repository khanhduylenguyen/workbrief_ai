# ---- Server ----
NODE_ENV=development
PORT=8081
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:8080
# Public base URL of this API (used to show the Zalo webhook URL to users)
PUBLIC_API_URL=http://localhost:8081

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/workbrief_ai

# ---- JWT (use long random strings, at least 32 chars each) ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Default admin (created on startup only if this email does not exist yet) ----
ADMIN_EMAIL=admin@workbrief.local
ADMIN_PASSWORD=ChangeMe@123
ADMIN_FULL_NAME=WorkBrief Admin

# ---- AI (Google Gemini) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# When GEMINI_API_KEY is empty and this is true, /ai-summarize returns a sample summary for testing
AI_MOCK_FALLBACK=true
