# ---- Server ----
NODE_ENV=development
PORT=8081
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:8080
# Public base URL of this API (used to show the Zalo webhook URL to users)
PUBLIC_API_URL=http://localhost:8081

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/workbrief_ai

# ---- JWT (use long random strings, at least 32 chars each) ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Default admin (created on startup only if this email does not exist yet) ----
ADMIN_EMAIL=admin@workbrief.local
ADMIN_PASSWORD=ChangeMe@123
ADMIN_FULL_NAME=WorkBrief Admin

# ---- Frontend (redirect target after Google OAuth) ----
FRONTEND_URL=http://localhost:8080

# ---- Gmail OAuth 2.0 (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type Web application) ----
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/api/integrations/gmail/callback
# Sync reads mail FROM colleagues in your contacts OR labelled with this Gmail label
GMAIL_SYNC_LABEL=WorkBrief
GMAIL_SYNC_MAX_MESSAGES=10
GMAIL_SYNC_NEWER_THAN_DAYS=7

# ---- Online payment: VNPay (register a sandbox merchant at https://sandbox.vnpayment.vn/devreg) ----
# Empty = payment disabled (expired accounts are told to contact the admin)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# IPN URL to register in the VNPay merchant portal: <PUBLIC_API_URL>/api/billing/vnpay/ipn
PLAN_STARTER_PRICE=49000
PLAN_PRO_PRICE=99000
PLAN_PRO_YEAR_PRICE=990000

# ---- Telegram bot (create with @BotFather; empty token = disabled) ----
TELEGRAM_BOT_TOKEN=
# Bot username without @, e.g. WorkBriefAIBot
TELEGRAM_BOT_USERNAME=
# Random string >= 16 chars; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# ---- Scheduled jobs & reminders ----
# Timezone for "today", reminder emails and relative deadlines ("chiều nay", "thứ 6")
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Secret for /api/cron/* (Vercel Cron sends Authorization: Bearer <CRON_SECRET>). Empty = cron disabled
CRON_SECRET=
GMAIL_AUTO_SYNC_MIN_INTERVAL_MINUTES=25
# SMTP for reminder emails (e.g. Gmail: smtp.gmail.com, 465, SMTP_SECURE=true, an App Password). Empty SMTP_HOST = disabled
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- AI (Google Gemini) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order if the primary model is overloaded (503), rate limited or retired
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# When GEMINI_API_KEY is empty and this is true, /ai-summarize returns a sample summary for testing
AI_MOCK_FALLBACK=true
